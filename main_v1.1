    def get_grade_level_from_record(self, student_data_json, db_grade_level):
        """Extract grade level from student_data JSON or database column"""
        if student_data_json:
            try:
                student_data = json.loads(student_data_json)
                grade_level = student_data.get('basic_info', {}).get('grade_level', '')
                if grade_level:
                    return grade_level
            except:
                pass
        
        # Fall back to database column
        return db_grade_level if db_grade_level else ""

    def load_credentials(self, search_text="", status="All", grade_level="All"):
        """Load student records from database"""
        # Clear existing items
        for item in self.cred_tree.get_children():
            self.cred_tree.delete(item)
        
        # Build query - UPDATED to include student_data
        query = '''
            SELECT id, username, password, last_name, category, attachments, 
                updated_at, grade_level, school_year, first_name, student_data
            FROM credentials 
            WHERE owner_id = ?
        '''
        params = [self.current_user]
        
        if search_text and search_text != "Search student records...":
            query += " AND (title LIKE ? OR username LIKE ? OR password LIKE ? OR last_name LIKE ? OR first_name LIKE ? OR middle_name LIKE ?)"
            search_pattern = f"%{search_text}%"
            params.extend([search_pattern, search_pattern, search_pattern, search_pattern, 
                        search_pattern, search_pattern])
        
        if status != "All":
            query += " AND category = ?"
            params.append(status)
        
        # Handle grade level filtering
        if grade_level != "All":
            # We need to filter after fetching because grade level might be in JSON
            # We'll filter in Python after fetching all matching records
            pass
        
        # Sort by ID in descending order so newest records appear first
        query += " ORDER BY id DESC"
        
        # Execute query
        self.cursor.execute(query, params)
        credentials = self.cursor.fetchall()
        
        # Filter by grade level in Python if needed
        filtered_credentials = []
        if grade_level != "All":
            for cred in credentials:
                cred_id, id_number, first_name, last_name, status_val, attachments_json, updated_at, db_grade_level, school_year, db_first_name, student_data_json = cred
                
                # Get grade level from student_data or database column
                actual_grade_level = self.get_grade_level_from_record(student_data_json, db_grade_level)
                
                # Check if it matches the filter
                if str(actual_grade_level) == str(grade_level):
                    filtered_credentials.append(cred)
                # Also check for "Grade X" format
                elif actual_grade_level and f"Grade {grade_level}" in actual_grade_level:
                    filtered_credentials.append(cred)
        else:
            filtered_credentials = credentials
        
        # Add to treeview with sequential numbers
        for index, cred in enumerate(filtered_credentials, 1):
            cred_id, id_number, first_name, last_name, status_val, attachments_json, updated_at, db_grade_level, school_year, db_first_name, student_data_json = cred
            
            # Use db_first_name for consistency
            display_first_name = db_first_name if db_first_name else first_name
            
            # Get grade level from student_data or database column
            actual_grade_level = self.get_grade_level_from_record(student_data_json, db_grade_level)
            
            # Parse attachments JSON
            try:
                attachments = json.loads(attachments_json) if attachments_json else []
            except:
                attachments = []
            
            # Display attachment count
            if attachments:
                display_attachments = f"{len(attachments)} file(s)"
            else:
                display_attachments = "No attachments"
            
            # Format date to remove time portion (keep only YYYY-MM-DD)
            if updated_at and len(updated_at) >= 10:
                formatted_date = updated_at[:10]  # Extract first 10 characters
            else:
                formatted_date = "N/A"
            
            # Format grade level - ONLY show grade level, remove school year from display
            if actual_grade_level and actual_grade_level.isdigit() and int(actual_grade_level) in range(7, 13):
                display_grade_level = f"Grade {actual_grade_level}"
            else:
                display_grade_level = actual_grade_level if actual_grade_level else "N/A"
            
            # Store database ID as tree item ID
            item_id = f"cred_{cred_id}"
            
            # Insert with the actual database ID as item ID
            self.cred_tree.insert('', 'end', 
                                iid=item_id,  # Store actual database ID as item ID
                                values=(index, id_number, display_first_name, last_name, 
                                    display_grade_level, status_val, display_attachments, formatted_date))

    def filter_credentials(self):
        """Filter student records based on search, status, and grade level"""
        search_text = self.search_var.get()
        status = self.status_var.get()
        
        # Access the grade_level_filter_var
        grade_level = self.grade_level_filter_var.get()
        
        self.load_credentials(search_text, status, grade_level)

    
