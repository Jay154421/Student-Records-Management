    def export_all_to_pdf(self):
        """Export all student records to PDF with formal school template"""
        try:
            # Get current filter values
            search_text = self.search_var.get() if hasattr(self, 'search_var') else ""
            status_filter = self.status_var.get() if hasattr(self, 'status_var') else "All"
            grade_level_filter = self.grade_level_filter_var.get() if hasattr(self, 'grade_level_filter_var') else "All"
            
            # Build query based on current filters
            query = '''
                SELECT id, username, password, last_name, category, first_name, middle_name, last_name, 
                    created_at, updated_at, grade_level, school_year, student_data
                FROM credentials 
                WHERE owner_id = ?
            '''
            params = [self.current_user]
            
            # Apply search filter
            if search_text and search_text != "Search student records...":
                query += " AND (title LIKE ? OR username LIKE ? OR password LIKE ? OR last_name LIKE ? OR first_name LIKE ? OR middle_name LIKE ?)"
                search_pattern = f"%{search_text}%"
                params.extend([search_pattern, search_pattern, search_pattern, search_pattern, 
                            search_pattern, search_pattern])
            
            # Apply status filter
            if status_filter != "All":
                query += " AND category = ?"
                params.append(status_filter)
            
            # Sort by ID in descending order so newest records appear first
            query += " ORDER BY id DESC"
            
            # Execute query
            self.cursor.execute(query, params)
            all_students = self.cursor.fetchall()
            
            # Apply grade level filtering in Python if needed
            students = []
            if grade_level_filter != "All":
                for student in all_students:
                    cred_id, id_number, first_name, last_name, status_val, fname, mname, lname, created_at, updated_at, db_grade_level, school_year, student_data_json = student
                    
                    # Get grade level from student_data or database column
                    actual_grade_level = self.get_grade_level_from_record(student_data_json, db_grade_level)
                    
                    # Check if it matches the filter
                    if str(actual_grade_level) == str(grade_level_filter):
                        students.append(student)
                    # Also check for "Grade X" format
                    elif actual_grade_level and f"Grade {grade_level_filter}" in actual_grade_level:
                        students.append(student)
            else:
                students = all_students
            
            if not students:
                messagebox.showwarning("No Data", f"No student records found matching the current filters.\n\nStatus: {status_filter}\nGrade Level: {grade_level_filter}")
