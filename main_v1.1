            elements.append(Paragraph("_" * 80, info_style))
            elements.append(Spacer(1, 10))
            
            # Official notice
            notice_text = "OFFICIAL STUDENT RECORD - St. Peter's College Student Records System"
            notice = Paragraph(notice_text, footer_style)
            elements.append(notice)
            
            # Confidential notice
            confidential_text = "CONFIDENTIAL - For official use only"
            confidential = Paragraph(confidential_text, footer_style)
            elements.append(confidential)
            
            # Page info
            page_info = Paragraph(f"Page 1 of 1 | Generated on: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}", footer_style)
            elements.append(page_info)
            
            # ==============================================================
            # BUILD PDF
            # ==============================================================
            doc.build(elements)
            
            messagebox.showinfo("Export Successful", 
                f"Student record exported successfully!\n\n"
                f"📋 <b>Student:</b> {full_name}\n"
                f"📁 <b>File:</b> {os.path.basename(file_path)}\n"
                f"📄 <b>Format:</b> PDF Document\n\n"
                f"The document includes all student information in a clean, organized layout.",
                parent=self.root)
            
        except Exception as e:
            messagebox.showerror("Export Error", f"Failed to export student record: {str(e)}")

    def add_new_credential(self):
        """Open dialog to add new student record with action-based optional fields"""
        dialog = tk.Toplevel(self.root)
        dialog.title("Add New Student Record")
        
        # Get screen dimensions
        screen_width = self.root.winfo_screenwidth()
        screen_height = self.root.winfo_screenheight()
        
        # Calculate dialog size (80% of screen, but max 1000x700)
        dialog_width = min(int(screen_width * 0.8), 1000)
        dialog_height = min(int(screen_height * 0.8), 700)
        
        dialog.geometry(f"{dialog_width}x{dialog_height}")
        dialog.configure(bg=self.colors['background'])
        dialog.transient(self.root)
        dialog.grab_set()
        
        # Center dialog on screen
        dialog.update_idletasks()
        x = (screen_width // 2) - (dialog_width // 2)
        y = (screen_height // 2) - (dialog_height // 2)
        dialog.geometry(f'{dialog_width}x{dialog_height}+{x}+{y}')
        
        # Make dialog non-resizable vertically but allow horizontal
        dialog.resizable(True, False)
        
        # ====================================================================
        # CREATE SCROLLABLE FRAME
        # ====================================================================
        
        # Create main container with scrollbar
        main_container = tk.Frame(dialog, bg=self.colors['background'])
        main_container.pack(fill=tk.BOTH, expand=True)
        
        # Create canvas and scrollbar
        canvas = tk.Canvas(main_container, bg=self.colors['background'], highlightthickness=0)
        scrollbar = ttk.Scrollbar(main_container, orient="vertical", command=canvas.yview)
        
