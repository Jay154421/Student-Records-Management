        def update_credential():
            """Update student record in database with new data structure"""
            try:
                # Get values from basic info fields
                id_number_val = id_entry.get()
                first_name_val = first_name_entry.get()
                middle_name_val = middle_name_entry.get()
                last_name_val = last_name_entry.get()
                lrn_val = lrn_entry.get()
                dob_val = dob_entry.get()
                gender_val = gender_var.get()
                contact_val = contact_entry.get()
                address_val = address_text.get("1.0", tk.END).strip()
                religion_val = religion_entry.get()
                status_val = status_var.get()
                father_name_val = father_entry.get()
                mother_name_val = mother_entry.get()
                # NEW FIELDS
                grade_level_val = grade_level_var.get()  # Add this
                school_year_val = school_year_entry.get()   # Add this
                
                # Validate required fields
                if not id_number_val:
                    messagebox.showerror("Error", "ID Number is required")
                    return
                
                if not first_name_val:
                    messagebox.showerror("Error", "First Name is required")
                    return
                
                if not last_name_val:
                    messagebox.showerror("Error", "Last Name is required")
                    return
                
                if gender_val == "Select Gender":
                    messagebox.showerror("Error", "Please select a gender")
                    return
                
                # Get action-specific fields based on status
                action_data = {}
                
                if status_val == "Graduate":
                    action_data = {
                        "last_school_year": grad_year_entry.get(),
                        "additional_contact": grad_contact_entry.get(),
                        "so_number": grad_so_entry.get(),
                        "date_issued": grad_date_entry.get(),
                        "series_year": grad_series_entry.get()
                    }
                elif status_val == "Transferred":
                    action_data = {
                        "transfer_school": transfer_school_entry.get(),
                        "transfer_date": transfer_date_entry.get(),
                        "transfer_reason": transfer_reason_text.get("1.0", tk.END).strip()
                    }
                elif status_val == "Dropout":
                    action_data = {
                        "dropout_date": dropout_date_entry.get(),
                        "dropout_reason": dropout_reason_text.get("1.0", tk.END).strip()
                    }
                elif status_val == "Retained":
                    action_data = {
                        "retain_grade": retain_grade_entry.get(),
                        "retain_reason": retain_reason_text.get("1.0", tk.END).strip()
                    }
                
                # Create title from name
                title_val = f"{first_name_val} {last_name_val} ({id_number_val})"
                
                # Handle attachments
                saved_attachments = []
                if selected_files:
                    student_dir = os.path.join(self.attachments_dir, f"student_{id_number_val}")
                    if not os.path.exists(student_dir):
                        os.makedirs(student_dir)
                    
                    for file_path in selected_files:
                        if os.path.exists(file_path):
                            # If file is already in the attachments directory, keep it
                            if file_path.startswith(self.attachments_dir):
                                saved_attachments.append(file_path)
                            else:
                                # Copy new file to attachments directory
                                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                                filename = f"{timestamp}_{os.path.basename(file_path)}"
                                dest_path = os.path.join(student_dir, filename)
                                shutil.copy2(file_path, dest_path)
                                saved_attachments.append(dest_path)
                
                # Clean up old attachments that are no longer selected
                for old_attachment in attachments:
                    if old_attachment not in selected_files and os.path.exists(old_attachment):
                        try:
                            os.remove(old_attachment)
                        except:
                            pass
                
                # Store ALL student data in JSON format
                student_data = {
                    "basic_info": {
                        "id_number": id_number_val,
                        "first_name": first_name_val,
                        "middle_name": middle_name_val,
                        "last_name": last_name_val,
                        "lrn": lrn_val,
                        "date_of_birth": dob_val,
                        "gender": gender_val,
                        "contact_number": contact_val,
                        "home_address": address_val,
                        "religion": religion_val,
                        "father_name": father_name_val,
                        "mother_name": mother_name_val
                    },
                    "action_data": action_data
                }
                
                student_data_json = json.dumps(student_data)
                
                # Get current timestamp
                current_timestamp = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
                
                # Update ALL fields in database including new columns
                self.cursor.execute('''
                    UPDATE credentials 
                    SET title = ?, username = ?, password = ?, attachments = ?, 
                        category = ?, first_name = ?, middle_name = ?, last_name = ?, 
                        lrn = ?, contact_number = ?, grade_level = ?, school_year = ?, updated_at = ?,
                        student_data = ?
                    WHERE id = ? AND owner_id = ?
                ''', (title_val, id_number_val, first_name_val, json.dumps(saved_attachments), 
                    status_val, first_name_val, middle_name_val, last_name_val,
                    lrn_val, contact_val, grade_level_val, school_year_val, current_timestamp, student_data_json,
                    cred_id, self.current_user))
                
                self.conn.commit()
                
                # Clean up mouse wheel binding
                try:
                    canvas.unbind_all("<MouseWheel>")
                except:
                    pass
                
                dialog.destroy()
                messagebox.showinfo("Success", f"Student record updated successfully!\nStatus: {status_val}")
                self.show_credentials()  # Refresh the student records list
                
            except Exception as e:
                messagebox.showerror("Error", f"Failed to update student record: {str(e)}\n\nDetails: {str(e)}")
        
