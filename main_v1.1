        def save_credential():
            """Save new student record to database"""
            try:
                # Get values from basic info fields
                id_number = id_entry.get()
                first_name = first_name_entry.get()
                middle_name = middle_name_entry.get()
                last_name = last_name_entry.get()
                lrn = lrn_entry.get()
                dob = dob_entry.get()
                gender = gender_var.get()
                contact_number = contact_entry.get()
                address = address_text.get("1.0", tk.END).strip()
                religion = religion_entry.get()
                status = status_var.get()
                father_name = father_entry.get()
                mother_name = mother_entry.get()
                # NEW FIELDS
                grade_level = grade_level_var.get()
                school_year = school_year_entry.get()
                
                # Validate required fields
                if not id_number or id_number == "Enter ID number":
                    id_number = "N/A"
                
                if not first_name or first_name == "Enter first name":
                    first_name = "N/A"
                
                if not last_name or last_name == "Enter last name":
                    last_name = "N/A"
                
                if gender == "Select Gender":
                    messagebox.showerror("Error", "Please select a gender")
                    return
                
                # Clean up optional fields
                if middle_name == "Enter middle name (optional)":
                    middle_name = "NA"
                
                if lrn == "Enter LRN (Learner Reference Number)":
                    lrn = ""
                
                if dob == "YYYY-MM-DD":
                    dob = ""
                
                if contact_number == "09123456789":
                    contact_number = ""
                
                if address == "Enter complete home address":
                    address = ""
                
                if religion == "Enter religion":
                    religion = ""
                
                if father_name == "Enter father's full name":
                    father_name = ""
                
                if mother_name == "Enter mother's full name":
                    mother_name = ""
                
                if grade_level == "Select Grade Level":
                    grade_level = ""
                
                if school_year == "e.g., 2023-2024":
                    school_year = ""
                
                # Get action-specific fields based on status
                action_data = {}
                
                if status == "Graduate":
                    action_data = {
                        "last_school_year": grad_year_entry.get() if grad_year_entry.get() != "e.g., 2023-2024" else "",
                        "additional_contact": grad_contact_entry.get() if grad_contact_entry.get() != "Additional contact number" else "",
                        "so_number": grad_so_entry.get() if grad_so_entry.get() != "e.g., SO-12345" else "",
                        "date_issued": grad_date_entry.get() if grad_date_entry.get() != "YYYY-MM-DD" else "",
                        "series_year": grad_series_entry.get() if grad_series_entry.get() != "e.g., 2023" else ""
                    }
                elif status == "Transferred":
                    action_data = {
                        "transfer_school": transfer_school_entry.get() if transfer_school_entry.get() != "Name of school transferring to" else "",
                        "transfer_date": transfer_date_entry.get() if transfer_date_entry.get() != "YYYY-MM-DD" else "",
                        "transfer_reason": transfer_reason_text.get("1.0", tk.END).strip() if transfer_reason_text.get("1.0", tk.END).strip() != "Reason for transfer" else ""
                    }
                elif status == "Dropout":
                    action_data = {
                        "dropout_date": dropout_date_entry.get() if dropout_date_entry.get() != "YYYY-MM-DD" else "",
                        "dropout_reason": dropout_reason_text.get("1.0", tk.END).strip() if dropout_reason_text.get("1.0", tk.END).strip() != "Reason for dropping out" else ""
                    }
                elif status == "Retained":
                    action_data = {
                        "retain_grade": retain_grade_entry.get() if retain_grade_entry.get() != "e.g., Grade 10" else "",
                        "retain_reason": retain_reason_text.get("1.0", tk.END).strip() if retain_reason_text.get("1.0", tk.END).strip() != "Reason for retention" else ""
                    }
                
                # Create title from name
                title = f"{first_name} {last_name} ({id_number})"
                
                # Handle attachments
                saved_attachments = []
                if selected_files:
                    student_dir = os.path.join(self.attachments_dir, f"student_{id_number}")
                    if not os.path.exists(student_dir):
                        os.makedirs(student_dir)
                    
                    for file_path in selected_files:
                        if os.path.exists(file_path):
                            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                            filename = f"{timestamp}_{os.path.basename(file_path)}"
                            dest_path = os.path.join(student_dir, filename)
                            shutil.copy2(file_path, dest_path)
                            saved_attachments.append(dest_path)
                
                # Store all student data in JSON format including new fields
                student_data = {
                    "basic_info": {
                        "id_number": id_number,
                        "first_name": first_name,
                        "middle_name": middle_name,
                        "last_name": last_name,
                        "lrn": lrn,
                        "date_of_birth": dob,
                        "gender": gender,
                        "contact_number": contact_number,
                        "home_address": address,
                        "religion": religion,
                        "father_name": father_name,
                        "mother_name": mother_name,
                        # NEW FIELDS
                        "grade_level": grade_level,
                        "school_year": school_year
                    },
                    "action_data": action_data
                }
                
                student_data_json = json.dumps(student_data)
                
                # Get current timestamp
                current_timestamp = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
                
                # Insert into database with updated fields including new columns
                self.cursor.execute('''
                    INSERT INTO credentials (title, username, password, attachments, category, 
                    first_name, middle_name, last_name, lrn, contact_number, grade_level, school_year, owner_id, student_data, updated_at)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                ''', (title, id_number, first_name, json.dumps(saved_attachments), status, 
                    first_name, middle_name, last_name, lrn, contact_number, 
                    grade_level, school_year, self.current_user, student_data_json, current_timestamp))
                
                self.conn.commit()
                
                # Clean up mouse wheel binding
                try:
                    canvas.unbind_all("<MouseWheel>")
                except:
                    pass
                
                dialog.destroy()
                messagebox.showinfo("Success", f"Student record saved successfully!\nStatus: {status}")
                self.show_credentials()  # Refresh the student records list
                
            except Exception as e:
                messagebox.showerror("Error", f"Failed to save student record: {str(e)}\n\nDetails: {str(e)}")
        
