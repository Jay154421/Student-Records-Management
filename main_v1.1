            This document contains confidential student information. Unauthorized disclosure, copying, distribution, 
            or use of this information is strictly prohibited. This report is generated for official school use only.
            """
            notice_para = Paragraph(notice_text, footer_style)
            elements.append(notice_para)
            
            # School information footer
            footer_text = f"""
            St. Peter's College - Student Records Office | Page 1 of 1 | Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
            """
            footer_para = Paragraph(footer_text, footer_style)
            elements.append(footer_para)
            
            # =====================================================
            # BUILD PDF
            # =====================================================
            doc.build(elements)
            
            messagebox.showinfo("Export Successful", 
                f"Formal student records report generated successfully!\n\n"
                f"📋 <b>Report Details:</b>\n"
                f"• File: {os.path.basename(file_path)}\n"
                f"• Location: {os.path.dirname(file_path)}\n"
                f"• Total Records: {len(students)}\n"
                f"• Filters Applied: {status_filter} | {grade_level_filter}\n\n"
                f"This formal report includes school letterhead, professional formatting,\n"
                f"and official summary statistics.",
                parent=self.root)
            
        except Exception as e:
            messagebox.showerror("Export Error", f"Failed to generate formal report: {str(e)}")

    def export_selected_to_pdf(self):
        """Export selected student record to PDF with enhanced UI-like formatting"""
        selection = self.cred_tree.selection()
        if not selection:
            messagebox.showwarning("No Selection", "Please select a student record to export")
            return
        
        item_id = selection[0]
        
        if not item_id.startswith("cred_"):
            messagebox.showerror("Error", "Invalid student record selection")
            return
        
        try:
            cred_id = int(item_id.split("_")[1])
        except:
            messagebox.showerror("Error", "Could not retrieve student record ID")
            return
        
        # Get student record details
        self.cursor.execute('''
            SELECT title, username, password, attachments, category, first_name, middle_name, last_name, 
                created_at, updated_at, last_school_year, contact_number, so_number, date_issued, 
                series_year, lrn, student_data, grade_level, school_year
            FROM credentials WHERE id = ? AND owner_id = ?
        ''', (cred_id, self.current_user))
        
        student = self.cursor.fetchone()
        
        if not student:
            messagebox.showerror("Error", "Student record not found")
            return
        
        # Unpack all fields
        (title, id_number, first_name, attachments_json, status, fname, mname, lname, 
        created_at, updated_at, last_school_year, contact_number, so_number, 
        date_issued, series_year, lrn_value, student_data_json, db_grade_level, db_school_year) = student
        
        # Parse student_data JSON
        student_data = {}
        basic_info = {}
        action_data = {}
        
        if student_data_json:
            try:
                student_data = json.loads(student_data_json)
                basic_info = student_data.get('basic_info', {})
                action_data = student_data.get('action_data', {})
            except:
                student_data = {}
                basic_info = {}
                action_data = {}
        
        # Parse attachments JSON
        attachments = []
        if attachments_json:
            try:
                attachments = json.loads(attachments_json) if attachments_json else []
            except:
                attachments = []
        
        # Extract information
        full_name = f"{lname}, {fname}"
        if mname and mname != "NA":
            full_name += f" {mname[0]}."
        
        # Extract all basic info
        lrn = basic_info.get('lrn', lrn_value)
        dob = basic_info.get('date_of_birth', '')
        gender = basic_info.get('gender', '')
        contact = basic_info.get('contact_number', contact_number)
        address = basic_info.get('home_address', '')
        religion = basic_info.get('religion', '')
        father_name = basic_info.get('father_name', '')
        mother_name = basic_info.get('mother_name', '')
        
        # Get grade level and school year from basic_info or database columns
        grade_level = basic_info.get('grade_level', db_grade_level)
        school_year = basic_info.get('school_year', db_school_year)
        
        # Extract action-specific data
        grad_last_school_year = action_data.get('last_school_year', last_school_year)
        grad_additional_contact = action_data.get('additional_contact', '')
        grad_so_number = action_data.get('so_number', so_number)
        grad_date_issued = action_data.get('date_issued', date_issued)
        grad_series_year = action_data.get('series_year', series_year)
        
        # Other action data
        transfer_school = action_data.get('transfer_school', '')
        transfer_date = action_data.get('transfer_date', '')
        transfer_reason = action_data.get('transfer_reason', '')
        dropout_date = action_data.get('dropout_date', '')
