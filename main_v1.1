    def parse_basic_info_from_text(self, text: str) -> dict:
        """
        Detect student information from labeled text lines.
        Works best if the PDF/DOCX has labels like:
        'ID Number: ...', 'First Name: ...', etc.
        """
        if not text:
            return {}

        cleaned = text.replace("\r", "\n")
        cleaned = re.sub(r"[ \t]+", " ", cleaned)

        def find_value(label_list):
            for lbl in label_list:
                # Label: Value
                pattern = rf"{re.escape(lbl)}\s*[:\-]\s*(.+)"
                match = re.search(pattern, cleaned, re.IGNORECASE)
                if match:
                    value = match.group(1).strip()
                    value = value.split("\n")[0].strip()
                    return value
            return ""

        data = {
            "id_number": find_value(["ID Number", "Student ID", "ID"]),
            "first_name": find_value(["First Name", "Firstname", "Given Name"]),
            "middle_name": find_value(["Middle Name", "Middlename"]),
            "last_name": find_value(["Last Name", "Lastname", "Surname", "Family Name"]),
            "lrn": find_value(["LRN", "Learner Reference Number"]),
            "date_of_birth": find_value(["Date of Birth", "Birthdate", "DOB"]),
            "gender": find_value(["Gender", "Sex"]),
            "contact_number": find_value(["Contact Number", "Mobile", "Phone"]),
            "home_address": find_value(["Home Address", "Address"]),
            "religion": find_value(["Religion"]),
            "father_name": find_value(["Father Name", "Father"]),
            "mother_name": find_value(["Mother Name", "Mother"]),
            "grade_level": find_value(["Grade Level", "Grade"]),
            "school_year": find_value(["School Year", "SY"]),
        }
        return data


    def extract_text_from_file(self, file_path: str) -> str:
        """Extract raw text from PDF or DOCX."""
        ext = os.path.splitext(file_path)[1].lower()

        if ext == ".pdf":
            reader = PdfReader(file_path)
            parts = []
            for page in reader.pages:
                page_text = page.extract_text()
                if page_text:
                    parts.append(page_text)
            return "\n".join(parts)

        if ext == ".docx":
            doc = Document(file_path)
            return "\n".join([p.text for p in doc.paragraphs if p.text is not None])

        raise ValueError("Unsupported file type. Please choose PDF or DOCX only.")


    def import_basic_info_from_pdf_docx(self, fill_callback):
        """Ask user to choose PDF/DOCX and fill basic info fields via callback."""
        file_path = filedialog.askopenfilename(
            title="Select PDF or DOCX File",
            filetypes=[("PDF files", "*.pdf"), ("Word files", "*.docx"), ("All files", "*.*")]
        )
        if not file_path:
            return

        try:
            raw_text = self.extract_text_from_file(file_path)
            if not raw_text.strip():
                messagebox.showerror("Import Failed", "Could not extract text from the file.")
                return

            parsed = self.parse_basic_info_from_text(raw_text)

            if not parsed or all(not v for v in parsed.values()):
                messagebox.showwarning(
                    "No Data Found",
                    "No labeled student info detected.\n\nTip: Make sure your file has labels like:\nID Number: ...\nFirst Name: ..."
                )
                return

            fill_callback(parsed)

            # ✅ OPTIONAL: open the file after import so user can see it
            try:
                self.open_file(file_path)
            except Exception:
                pass

            messagebox.showinfo("Import Success", "Basic information imported successfully ✅")

        except Exception as e:
            messagebox.showerror("Import Error", f"Failed to import file:\n\n{e}")

    def hash_password(self, password):
        """Hash password using SHA-256"""
        return hashlib.sha256(password.encode()).hexdigest()
    
