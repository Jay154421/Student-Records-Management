            # Create statistics text
            stats_text = f"""
            <b>Status Distribution:</b><br/>
            """
            
            for status, count in sorted(status_counts.items()):
                percentage = (count / len(students) * 100) if len(students) > 0 else 0
                stats_text += f"• {status}: {count} student(s) ({percentage:.1f}%)<br/>"
            
            stats_text += f"""
            <br/><b>Grade Level Distribution:</b><br/>
            """
            
            for grade, count in sorted(grade_counts.items(), key=lambda x: int(x[0]) if x[0].isdigit() else 0):
                percentage = (count / len(students) * 100) if len(students) > 0 else 0
                grade_display = f"Grade {grade}" if grade.isdigit() else grade
                stats_text += f"• {grade_display}: {count} student(s) ({percentage:.1f}%)<br/>"
            
            stats_text += f"""
            <br/><b>Report Summary:</b><br/>
            • Total Records: {len(students)}<br/>
            • Generated by: Student Records Management System<br/>
            • Report ID: REP-{datetime.now().strftime('%Y%m%d%H%M%S')}<br/>
