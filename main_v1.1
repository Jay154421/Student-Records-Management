                fg=self.colors['dark'],
                bg=self.colors['background']
            ).pack(pady=5)
            
            # File info
            try:
                file_size = os.path.getsize(filepath)
                file_size_str = f"{file_size / 1024:.1f} KB" if file_size < 1024*1024 else f"{file_size / (1024*1024):.1f} MB"
                
                tk.Label(
