            # Count by status
            status_counts = {}
            grade_counts = {}
            
            for student in students:
                status = student[4]
                student_data_json = student[12]
                db_grade_level = student[10]
                
                # Status counts
                status_counts[status] = status_counts.get(status, 0) + 1
                
                # Grade level counts
                actual_grade_level = self.get_grade_level_from_record(student_data_json, db_grade_level)
                if actual_grade_level:
