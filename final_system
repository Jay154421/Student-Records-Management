    def export_my_class_to_pdf(self):
        """Export teacher's assigned class to PDF"""
        try:
            if not self.current_teacher_info:
                messagebox.showwarning("No Assignment", "You are not assigned to any grade/section.")
                return
            
            grade = self.current_teacher_info['grade']
            section = self.current_teacher_info['section']
            
            # Get all students in the assigned grade and section
            self.cursor.execute('''
                SELECT id, username, first_name, middle_name, last_name, category, created_at, updated_at, lrn, status 
                FROM credentials 
                WHERE grade_level = ? AND section = ? AND teacher_id = ?
                ORDER BY last_name, first_name
            ''', (grade, section, self.current_user))
            
            students = self.cursor.fetchall()
            
            if not students:
                messagebox.showwarning("No Data", f"No students found in Grade {grade} - {section}")
                return
            
            # Ask for save location
            file_path = filedialog.asksaveasfilename(
                defaultextension=".pdf",
                filetypes=[("PDF files", "*.pdf"), ("All files", "*.*")],
                initialfile=f"class_grade{grade}_{section}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.pdf"
            )
            
            if not file_path:
                return
            
            # Create PDF document
            doc = SimpleDocTemplate(file_path, pagesize=A4)
            elements = []
            
            # Get styles
            styles = getSampleStyleSheet()
            
            # Title
            title_style = ParagraphStyle(
                'CustomTitle',
                parent=styles['Heading1'],
                fontSize=20,
                textColor=colors.HexColor('#800000'),  # Maroon
                spaceAfter=30
            )
            
            title = Paragraph(f"Class List: Grade {grade} - {section}", title_style)
            elements.append(title)
            
            # Subtitle
            subtitle_style = ParagraphStyle(
                'CustomSubtitle',
                parent=styles['Normal'],
                fontSize=12,
                textColor=colors.HexColor('#666666'),
                spaceAfter=20
            )
            
            # Get teacher name
            self.cursor.execute('SELECT full_name FROM users WHERE id = ?', (self.current_user,))
            teacher_name = self.cursor.fetchone()[0]
            
            subtitle = Paragraph(f"Generated on: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}<br/>Teacher: {teacher_name}<br/>Total Students: {len(students)}", subtitle_style)
            elements.append(subtitle)
            
            elements.append(Spacer(1, 20))
            
            # Create table data
            table_data = [['ID', 'LRN', 'ID Number', 'Full Name', 'Category', 'Status', 'Created']]
            
            for student in students:
                cred_id, id_number, first_name, mname, lname, category, created_at, updated_at, lrn, status = student
                
                # Format name
                full_name = f"{first_name} {mname + ' ' if mname else ''}{lname}".strip()
                
                # Format dates
                created_date = created_at[:10] if created_at else "N/A"
                
                table_data.append([str(cred_id), lrn if lrn else 'N/A', id_number, full_name, category, status if status else 'Active', created_date])
            
            # Create table
            table = Table(table_data, colWidths=[0.5*inch, 1*inch, 1*inch, 2*inch, 1*inch, 1*inch, 1*inch])
            
            # Style the table
