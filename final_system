    def load_classes(self):
        """Load classes for current teacher."""
        if not hasattr(self, 'class_tree'):
            return

        # Clear
        for item in self.class_tree.get_children():
            self.class_tree.delete(item)

        teacher_id = self._get_teacher_context_id()
        self.cursor.execute('''
            SELECT c.id, c.class_name, c.grade_level, c.section, c.school_year, c.updated_at,
                   (SELECT COUNT(*) FROM class_students cs WHERE cs.class_id = c.id) AS student_count
            FROM classes c
            WHERE c.teacher_id = ?
            ORDER BY c.updated_at DESC, c.id DESC
        ''', (teacher_id,))
        rows = self.cursor.fetchall()

        for r in rows:
            class_id, name, grade, section, sy, updated_at, student_count = r
            self.class_tree.insert('', 'end', values=(class_id, name or '', grade or '', section or '', sy or '', student_count, updated_at))

