    def set_active_menu(self, index: int):
        """Set the active (selected) sidebar menu item."""
        self.active_menu_index = index

        # Reset all items to normal
        for i, frame in enumerate(getattr(self, 'menu_frames', [])):
            try:
                normal_bg = self.colors['sidebar']
                active_bg = self.colors.get('active_item', self.colors['hover'])
                bg = active_bg if i == index else normal_bg

                frame.config(bg=bg)
                # Sync all children (icon + text)
                for child in frame.winfo_children():
                    child.config(bg=bg)
            except Exception:
                pass

    def on_menu_leave(self, frame, icon_lbl, text_lbl, index):
        """When the mouse leaves a menu item, restore active highlight."""
        if index == getattr(self, 'active_menu_index', None):
            # keep active highlight
            active_bg = self.colors.get('active_item', self.colors['hover'])
            self.on_menu_hover(frame, icon_lbl, text_lbl, active_bg)
        else:
            self.on_menu_hover(frame, icon_lbl, text_lbl, self.colors['sidebar'])

    def on_menu_hover(self, frame, icon_lbl, text_lbl, bg_color):
        """Sync hover background for sidebar menu item (frame + icon + text)."""
        frame.config(bg=bg_color)
        icon_lbl.config(bg=bg_color)
        text_lbl.config(bg=bg_color)


