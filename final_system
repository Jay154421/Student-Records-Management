        def save_credential():
            """Save new student record to database"""
            try:
                # Get values
                lrn = entries['LRN'].get()
                id_number = entries['ID Number'].get()
                first_name = entries['First Name'].get()
                middle_name = entries['Middle Name'].get()
                last_name = entries['Last Name'].get()
                grade_level = entries['Grade Level'].get()
                section = entries['Section'].get()
                status = entries['Status'].get()
                
                # Validate required fields
                if not lrn:
                    messagebox.showerror("Error", "LRN is required")
                    return
                
                if not id_number or id_number == "Enter student ID number (optional)":
                    id_number = ""
                
                if not first_name or first_name == "Enter first name":
                    messagebox.showerror("Error", "First Name is required")
                    return
                
                if not last_name or last_name == "Enter last name":
                    messagebox.showerror("Error", "Last Name is required")
                    return
                
                # For teachers, use their assigned grade/section
                if self.current_role == 'user' and self.current_teacher_info:
                    grade_level = self.current_teacher_info['grade']
                    section = self.current_teacher_info['section']
                else:
                    # Admin or unassigned teacher
                    if not grade_level or grade_level == "Enter grade level (e.g., 5, 6, 7)":
                        messagebox.showerror("Error", "Grade Level is required")
                        return
                    
                    if not section or section == "Enter section (e.g., Selos, Mercury)":
                        messagebox.showerror("Error", "Section is required")
                        return
                
                # Clean up optional fields
                if middle_name == "Enter middle name (optional)":
                    middle_name = ""
                
                # Get category (admin only) and graduate-specific fields
                category = "Undergraduate"  # Default for teachers
                last_school_year = ""
                contact_number = ""
                so_number = ""
                date_issued = ""
                series_year = ""
                
                if self.current_role == 'admin':
                    category = entries['Category'].get()
                    
                    if category == "Graduate":
                        last_school_year = graduate_entries["Last School Year Attended"]['widget'].get()
                        if last_school_year == "Enter last school year attended":
                            last_school_year = ""
                        
                        contact_number = graduate_entries["Contact Number"]['widget'].get()
                        if contact_number == "Enter contact number":
                            contact_number = ""
                        
                        so_number = graduate_entries["SO Number"]['widget'].get()
                        if so_number == "Enter SO number":
                            so_number = ""
                        
                        date_issued = graduate_entries["Date Issued"]['widget'].get()
                        if date_issued == "Enter date issued (YYYY-MM-DD)":
                            date_issued = ""
                        
                        series_year = graduate_entries["Series of Year"]['widget'].get()
                        if series_year == "Enter series of year":
                            series_year = ""
                
                # Create title from name
                ref_code = id_number if id_number else lrn
                title = f"{first_name} {last_name} ({ref_code})"
                
                # Handle attachments - create folder first, then copy files
                saved_attachments = []
                if selected_files:
                    # Create student-specific directory
                    student_folder_name = f"student_{(id_number if id_number else lrn)}"
                    student_dir = os.path.join(self.attachments_dir, student_folder_name)
                    if not os.path.exists(student_dir):
                        os.makedirs(student_dir)
                    
                    # Copy files to the student's folder
                    for file_path in selected_files:
                        if os.path.exists(file_path):
                            # Generate unique filename
                            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                            file_ext = os.path.splitext(file_path)[1]
                            filename = f"{timestamp}_{first_name}_{last_name}{file_ext}"
                            dest_path = os.path.join(student_dir, filename)
                            
                            # Copy file to attachments directory
                            shutil.copy2(file_path, dest_path)
                            saved_attachments.append(dest_path)
                
                # Insert into database with teacher_id
                self.cursor.execute('''
                    INSERT INTO credentials (title, username, password, attachments, category, first_name, middle_name, last_name, 
                                            owner_id, teacher_id, last_school_year, contact_number, so_number, date_issued, series_year, 
                                            lrn, status, grade_level, section)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                ''', (title, id_number, first_name, json.dumps(saved_attachments), category, first_name, middle_name, 
                      last_name, self.current_user, self.current_user if self.current_role == 'user' else None, 
                      last_school_year, contact_number, so_number, date_issued, 
                      series_year, lrn, status, grade_level, section))
                self.conn.commit()
                
                messagebox.showinfo("Success", f"Student record saved successfully!\n{len(saved_attachments)} attachment(s) added.")
                dialog.destroy()
                self.show_credentials()  # Refresh the student records list
                
