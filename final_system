            if default is not None and default != "":
                e.insert(0, str(default))
            return e

        prelim_e = _grade_field("Prelim", row[0])
        midterm_e = _grade_field("Midterm", row[1])
        semifinal_e = _grade_field("Semifinal", row[2])
        final_e = _grade_field("Final", row[3])

        def to_float(v):
            v = str(v).strip()
            if v == "":
                return None
            try:
                return float(v)
            except ValueError:
                raise ValueError("Grades must be numbers (e.g., 89.5)")

        def save():
            try:
                p = to_float(prelim_e.get())
                m = to_float(midterm_e.get())
                s = to_float(semifinal_e.get())
                f = to_float(final_e.get())
            except ValueError as ex:
                messagebox.showerror("Invalid", str(ex))
                return

            # Upsert
            self.cursor.execute('''
                INSERT INTO student_grades (class_id, student_id, prelim, midterm, semifinal, final, created_at, updated_at)
                VALUES (?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
                ON CONFLICT(class_id, student_id) DO UPDATE SET
                    prelim = excluded.prelim,
                    midterm = excluded.midterm,
                    semifinal = excluded.semifinal,
                    final = excluded.final,
                    updated_at = CURRENT_TIMESTAMP
            ''', (class_id, student_id, p, m, s, f))
