        self.root.geometry(f'{width}x{height}+{x}+{y}')
    
    def init_database(self):
        """Initialize database and create default admin"""
        self.conn = sqlite3.connect('modern_users.db')
        self.cursor = self.conn.cursor()

        # Ensure foreign keys are enabled
        try:
            self.cursor.execute('PRAGMA foreign_keys = ON')
        except Exception:
            pass
        
        # Create users table with teacher assignments
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS users (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                username TEXT UNIQUE NOT NULL,
                password TEXT NOT NULL,
                role TEXT DEFAULT 'user',
                email TEXT,
                full_name TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                last_login TIMESTAMP,
                -- Teacher-specific fields
                assigned_grade TEXT,
                assigned_section TEXT
            )
        ''')
        
        # Create credentials table (now for student records) with grade and section and teacher_id
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS credentials (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                username TEXT,  -- Will store ID Number (optional)
                password TEXT NOT NULL,  -- Will store First Name
                attachments TEXT,        -- Will store JSON list of attachment paths
                category TEXT DEFAULT 'Student',
                first_name TEXT,
                middle_name TEXT,
                last_name TEXT,
                owner_id INTEGER,
                teacher_id INTEGER,  -- NEW: Track which teacher added this student
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                -- Graduate-specific fields
                last_school_year TEXT,
                contact_number TEXT,
                so_number TEXT,
                date_issued TEXT,
                series_year TEXT,
                lrn TEXT,
                status TEXT DEFAULT 'Active',
                -- Grade and section fields for filtering
                grade_level TEXT,
                section TEXT
            )
        ''')

        # ============================
        # NEW: Teacher Class Management
        # ============================
        # Teachers can create their own classes (grade + section + school year).
        # Students can be linked to a class; grades can be stored per class/student.
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS classes (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                teacher_id INTEGER NOT NULL,
                class_name TEXT,
                grade_level TEXT,
                section TEXT,
                school_year TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (teacher_id) REFERENCES users(id) ON DELETE CASCADE
            )
        ''')

        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS class_students (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                class_id INTEGER NOT NULL,
                student_id INTEGER NOT NULL,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                UNIQUE(class_id, student_id),
                FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
                FOREIGN KEY (student_id) REFERENCES credentials(id) ON DELETE CASCADE
            )
        ''')

        # Store grades per class/student in 4 grading periods
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS student_grades (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                class_id INTEGER NOT NULL,
                student_id INTEGER NOT NULL,
                prelim REAL,
                midterm REAL,
                semifinal REAL,
                final REAL,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                UNIQUE(class_id, student_id),
                FOREIGN KEY (class_id) REFERENCES classes(id) ON DELETE CASCADE,
                FOREIGN KEY (student_id) REFERENCES credentials(id) ON DELETE CASCADE
            )
        ''')
        
        # Check if attachments column exists, if not add it
        try:
            self.cursor.execute("SELECT attachments FROM credentials LIMIT 1")
        except sqlite3.OperationalError:
            # Column doesn't exist, add it
            self.cursor.execute('ALTER TABLE credentials ADD COLUMN attachments TEXT')
