    def exit_teacher_view(self):
        """Exit teacher view mode and restore admin context"""
        if self.is_admin_viewing_teacher and self.original_admin_info:
            # Restore original admin info
            self.current_user = self.original_admin_info['user_id']
            self.current_role = self.original_admin_info['role']
            self.current_teacher_info = self.original_admin_info['teacher_info']
            self.is_admin_viewing_teacher = False
            
            # Get admin info from database
            self.cursor.execute('SELECT full_name, role, email, assigned_grade, assigned_section FROM users WHERE id = ?', 
                              (self.current_user,))
            user_info = self.cursor.fetchone()
            
            if user_info:
                full_name, role, email, grade, section = user_info
                # Show admin dashboard
                self.show_dashboard(full_name, role, email, grade, section)
    
    def toggle_sidebar(self):
        """Toggle sidebar visibility with smooth animation"""
        if self.sidebar_visible:
            # Hide sidebar
            self.sidebar.pack_forget()
            self.hamburger_btn.config(text="☰")
            self.sidebar_visible = False
        else:
            # Show sidebar
            self.sidebar.pack(side=tk.LEFT, fill=tk.Y, before=self.main_content)
            self.hamburger_btn.config(text="✕")
            self.sidebar_visible = True
        
        # Update layout to stretch content
        self.main_frame.update_idletasks()
        self.root.update_idletasks()
    
