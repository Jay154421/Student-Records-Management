        item = self.user_tree.item(sel[0])
        vals = item.get("values", [])
        if not vals:
            return

        uid, username, full_name, role, email, assigned_grade, assigned_section, *_ = vals

        self.um_id_var.set(uid)
        self.um_username_var.set(username)
        self.um_fullname_var.set(full_name)
        self.um_role_var.set(role if role else "user")
        self.um_email_var.set(email)
        self.um_grade_var.set(assigned_grade if assigned_grade else "")
        self.um_section_var.set(assigned_section if assigned_section else "")
        self.um_password_var.set("")  # do not reveal password
    
