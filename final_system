    def load_teachers(self, search_text=""):
        """Load teachers from database with optional search"""
        if not hasattr(self, 'teacher_tree'):
            return
        
        # Clear existing items
        for item in self.teacher_tree.get_children():
            self.teacher_tree.delete(item)
        
        # Build query
        query = '''
            SELECT u.id, u.username, u.full_name, u.email, u.assigned_grade, u.assigned_section, 
                   u.created_at, u.last_login, COUNT(c.id) as student_count
            FROM users u
            LEFT JOIN credentials c ON u.id = c.teacher_id
            WHERE u.role = 'user'
        '''
        params = []
        
        if search_text and search_text != "Search teachers...":
            query += " AND (u.username LIKE ? OR u.full_name LIKE ? OR u.email LIKE ? OR u.assigned_grade LIKE ? OR u.assigned_section LIKE ?)"
            search_pattern = f"%{search_text}%"
            params.extend([search_pattern, search_pattern, search_pattern, search_pattern, search_pattern])
        
        query += " GROUP BY u.id ORDER BY u.full_name"
        
        # Execute query
        self.cursor.execute(query, params)
        teachers = self.cursor.fetchall()
        
        # Add to treeview
        for teacher in teachers:
            teacher_id, username, full_name, email, grade, section, created_at, last_login, student_count = teacher
            
            created = created_at[:10] if created_at else ""
            last = last_login[:10] if last_login else ""
            
            self.teacher_tree.insert('', 'end', values=(
                teacher_id, username, full_name, email, 
                grade if grade else "N/A", section if section else "N/A", 
                str(student_count), created, last
            ))
    
