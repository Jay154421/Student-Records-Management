    def darken_color(self, color):
        """Darken color for hover effect"""
        if color == self.colors['primary']:
            return '#5a0019'
        elif color == self.colors['success']:
            return '#218838'
        elif color == self.colors['info']:
            return '#138496'
        elif color == self.colors['warning']:
            return '#e0a800'
        else:
            return color

