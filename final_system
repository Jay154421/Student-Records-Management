        selection = self.cred_tree.selection()
        if not selection:
            messagebox.showwarning("No Selection", "Please select a student record with images to export")
            return
        
        item = self.cred_tree.item(selection[0])
        cred_id = item['values'][0]
        
        # Get student record details with attachments
        if self.current_role == 'admin' and not self.is_admin_viewing_teacher:
            self.cursor.execute('''
                SELECT title, username, first_name, attachments, category, first_name, middle_name, last_name, created_at, updated_at, lrn, status 
                FROM credentials 
                WHERE id = ?
            ''', (cred_id,))
        else:
            self.cursor.execute('''
                SELECT title, username, first_name, attachments, category, first_name, middle_name, last_name, created_at, updated_at, lrn, status 
                FROM credentials 
                WHERE id = ? AND teacher_id = ?
            ''', (cred_id, self.current_user))
        
        student = self.cursor.fetchone()
        
