        event.widget.config(bg=color)
    
    def toggle_password_visibility(self):
        """Toggle password visibility"""
        if self.show_password_var.get():
            self.password_entry.config(show="")
        else:
            self.password_entry.config(show="•")
    
    def login(self):
        """Handle login process"""
        username = self.username_entry.get().strip()
        password = self.password_entry.get().strip()
        
        if not username or not password:
            messagebox.showerror("Error", "Please enter both username and password")
            return
        
        # Animate login button
        self.login_button.config(text="SIGNING IN...", state='disabled')
        self.root.update()
        
        # Hash the entered password
        hashed_password = self.hash_password(password)
        
        # Check credentials
        self.cursor.execute('''
            SELECT * FROM users 
            WHERE username = ? AND password = ?
        ''', (username, hashed_password))
        
        user = self.cursor.fetchone()
        
        if user:
            # Update last login
            self.cursor.execute('''
                UPDATE users SET last_login = CURRENT_TIMESTAMP 
                WHERE username = ?
            ''', (username,))
            self.conn.commit()
            
            (user_id, username, _, role, email, full_name, created_at, 
             last_login, assigned_grade, assigned_section) = user
            
            self.current_user = user_id
            self.current_role = role
            
            # Store teacher's assignment info
            if role == 'user':  # Teacher role
                self.current_teacher_info = {
                    'grade': assigned_grade,
                    'section': assigned_section
                }
            else:
                self.current_teacher_info = None
            
            # Reset admin viewing state
            self.is_admin_viewing_teacher = False
            self.original_admin_info = None
            
            self.show_dashboard(full_name, role, email, assigned_grade, assigned_section)
        else:
            self.login_button.config(text="SIGN IN", state='normal')
            messagebox.showerror("Access Denied", "Invalid username or password")
    
