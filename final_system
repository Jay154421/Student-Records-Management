    def _load_class_students_into_tree(self, class_id, tree):
        for it in tree.get_children():
            tree.delete(it)
        self.cursor.execute('''
            SELECT c.id, c.lrn, c.username, c.first_name, c.last_name, c.status
            FROM class_students cs
            JOIN credentials c ON cs.student_id = c.id
            WHERE cs.class_id = ?
            ORDER BY c.last_name, c.first_name
        ''', (class_id,))
        for row in self.cursor.fetchall():
            tree.insert('', 'end', values=row)

    
    def _load_class_grades_into_tree(self, class_id, tree):
        """Load grades table including computed Total/GPA (average of available grading periods)."""
        for it in tree.get_children():
            tree.delete(it)

        # total_gpa = average of non-null periods
        self.cursor.execute('''
            SELECT c.id,
                   (c.first_name || ' ' || c.last_name) AS student_name,
                   COALESCE(g.prelim, ''), COALESCE(g.midterm, ''), COALESCE(g.semifinal, ''), COALESCE(g.final, ''),
                   (
                     CASE
                       WHEN g.prelim IS NULL AND g.midterm IS NULL AND g.semifinal IS NULL AND g.final IS NULL THEN ''
                       ELSE ROUND(
                         (
                           COALESCE(g.prelim, 0) + COALESCE(g.midterm, 0) + COALESCE(g.semifinal, 0) + COALESCE(g.final, 0)
                         ) / NULLIF(
                           (CASE WHEN g.prelim IS NOT NULL THEN 1 ELSE 0 END) +
                           (CASE WHEN g.midterm IS NOT NULL THEN 1 ELSE 0 END) +
                           (CASE WHEN g.semifinal IS NOT NULL THEN 1 ELSE 0 END) +
                           (CASE WHEN g.final IS NOT NULL THEN 1 ELSE 0 END),
                           0
                         ), 2
                       )
                     END
                   ) AS total_gpa
            FROM class_students cs
            JOIN credentials c ON cs.student_id = c.id
            LEFT JOIN student_grades g ON g.class_id = cs.class_id AND g.student_id = c.id
            WHERE cs.class_id = ?
            ORDER BY c.last_name, c.first_name
        ''', (class_id,))

        for row in self.cursor.fetchall():
            tree.insert('', 'end', values=row)

