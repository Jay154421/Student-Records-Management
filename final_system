    def _username_exists(self, username, exclude_user_id=None):
        """Check if a username already exists."""
        if exclude_user_id:
            self.cursor.execute("SELECT 1 FROM users WHERE username=? AND id<>?", (username, exclude_user_id))
        else:
            self.cursor.execute("SELECT 1 FROM users WHERE username=?", (username,))
        return self.cursor.fetchone() is not None
    
    def add_user(self):
        """Add new user to database."""
        username = self.um_username_var.get().strip()
        full_name = self.um_fullname_var.get().strip()
        email = self.um_email_var.get().strip()
        role = self.um_role_var.get().strip() or "user"
        grade = self.um_grade_var.get().strip()
        section = self.um_section_var.get().strip()
        password = self.um_password_var.get().strip()

        if not username or not password:
            messagebox.showerror("Error", "Username and Password are required.")
            return

        if self._username_exists(username):
            messagebox.showerror("Error", "Username already exists.")
            return

        try:
            hashed = self.hash_password(password)
            self.cursor.execute("""
                INSERT INTO users (username, password, role, email, full_name, assigned_grade, assigned_section)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            """, (username, hashed, role, email, full_name, grade, section))
            self.conn.commit()
            messagebox.showinfo("Success", "User added successfully ✅")
            self.clear_user_form()
            self.load_users_table()
        except Exception as e:
            messagebox.showerror("Error", f"Failed to add user:\n{e}")
    
    def update_user(self):
        """Update selected user info (does not change password)."""
        user_id = self.um_id_var.get().strip()
        if not user_id:
            messagebox.showwarning("No Selection", "Please select a user from the list first.")
            return

        username = self.um_username_var.get().strip()
        full_name = self.um_fullname_var.get().strip()
        email = self.um_email_var.get().strip()
        role = self.um_role_var.get().strip() or "user"
        grade = self.um_grade_var.get().strip()
        section = self.um_section_var.get().strip()

        if not username:
            messagebox.showerror("Error", "Username is required.")
            return

        try:
            uid_int = int(user_id)
        except:
            messagebox.showerror("Error", "Invalid user ID.")
            return

        if self._username_exists(username, exclude_user_id=uid_int):
            messagebox.showerror("Error", "Username already exists.")
            return

        try:
            self.cursor.execute("""
                UPDATE users
                SET username=?, full_name=?, email=?, role=?, assigned_grade=?, assigned_section=?
                WHERE id=?
            """, (username, full_name, email, role, grade, section, uid_int))
            self.conn.commit()
            messagebox.showinfo("Success", "User updated successfully ✅")
            self.load_users_table()
        except Exception as e:
            messagebox.showerror("Error", f"Failed to update user:\n{e}")
    
    def delete_user(self):
        """Delete selected user. Prevent deleting current user."""
        user_id = self.um_id_var.get().strip()
        if not user_id:
            messagebox.showwarning("No Selection", "Please select a user from the list first.")
            return

        try:
            uid_int = int(user_id)
        except:
            messagebox.showerror("Error", "Invalid user ID.")
            return

        if uid_int == self.current_user:
            messagebox.showerror("Blocked", "You cannot delete the account you are currently logged in with.")
            return

        if messagebox.askyesno("Confirm Delete", "Are you sure you want to delete this user?"):
            try:
                self.cursor.execute("DELETE FROM users WHERE id=?", (uid_int,))
                self.conn.commit()
                messagebox.showinfo("Success", "User deleted successfully ✅")
                self.clear_user_form()
                self.load_users_table()
            except Exception as e:
                messagebox.showerror("Error", f"Failed to delete user:\n{e}")
    
    def reset_user_password(self):
        """Reset password for selected user using password field value."""
        user_id = self.um_id_var.get().strip()
        if not user_id:
            messagebox.showwarning("No Selection", "Please select a user first.")
            return

        new_pass = self.um_password_var.get().strip()
        if not new_pass:
            messagebox.showerror("Error", "Enter a new password in the Password field first.")
            return

        try:
            uid_int = int(user_id)
        except:
            messagebox.showerror("Error", "Invalid user ID.")
            return

        if messagebox.askyesno("Confirm", "Reset password for this user?"):
            try:
                hashed = self.hash_password(new_pass)
                self.cursor.execute("UPDATE users SET password=? WHERE id=?", (hashed, uid_int))
                self.conn.commit()
                messagebox.showinfo("Success", "Password reset successfully ✅")
                self.um_password_var.set("")
            except Exception as e:
                messagebox.showerror("Error", f"Failed to reset password:\n{e}")
    
    def backup_database(self):
        """Creates a backup copy of your database."""
        # Only admin can backup database (not when viewing teacher)
        if self.is_admin_viewing_teacher:
            messagebox.showwarning("Readonly Mode", "You are in viewing mode. Cannot backup database.")
            return
        
        if self.current_role != 'admin':
            messagebox.showwarning("Access Denied", "Only administrators can backup the database.")
            return
        
        try:
            db_file = "modern_users.db"

            if not os.path.exists(db_file):
                messagebox.showerror("Error", f"Database file not found:\n{db_file}")
                return

            save_path = filedialog.asksaveasfilename(
                title="Save Database Backup",
                defaultextension=".db",
                filetypes=[("Database File", "*.db"), ("All Files", "*.*")],
                initialfile=f"backup_{datetime.now().strftime('%Y%m%d_%H%M%S')}.db"
            )

            if not save_path:
                return  # Cancelled

            shutil.copy(db_file, save_path)

            messagebox.showinfo("Backup Success", f"Database backup saved ✅\n\n{save_path}")

        except Exception as e:
            messagebox.showerror("Backup Error", f"Failed to backup database:\n\n{e}")
    
