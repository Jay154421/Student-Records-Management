    def load_credentials(self, search_text="", category="All"):
        """Load student records from database with role-based filtering"""
        # Clear existing items
        for item in self.cred_tree.get_children():
            self.cred_tree.delete(item)
        
        # Build query based on role
        if self.is_admin_viewing_teacher:
            # Admin viewing teacher - show only teacher's students
            query = '''
                SELECT id, lrn, username, first_name, last_name, status, attachments, updated_at
                FROM credentials 
                WHERE teacher_id = ?
            '''
            params = [self.current_user]
        elif self.current_role == 'admin' and not self.is_admin_viewing_teacher:
            # Admin sees all students
            query = '''
                SELECT c.id, c.lrn, c.username, c.first_name, c.last_name, c.grade_level, c.section, 
                       c.category, c.status, c.attachments, c.updated_at, u.full_name as teacher_name
                FROM credentials c
                LEFT JOIN users u ON c.teacher_id = u.id
                WHERE 1=1
            '''
            params = []
        else:
            # Teacher sees only students they added
            query = '''
                SELECT id, lrn, username, first_name, last_name, status, attachments, updated_at
                FROM credentials 
                WHERE teacher_id = ?
            '''
            params = [self.current_user]
        
        if search_text and search_text != "Search student records...":
            if self.current_role == 'admin' and not self.is_admin_viewing_teacher:
                query += " AND (c.first_name LIKE ? OR c.last_name LIKE ? OR c.lrn LIKE ? OR c.username LIKE ? OR c.grade_level LIKE ? OR c.section LIKE ?)"
                search_pattern = f"%{search_text}%"
                params.extend([search_pattern, search_pattern, search_pattern, search_pattern, search_pattern, search_pattern])
            else:
                query += " AND (first_name LIKE ? OR last_name LIKE ? OR lrn LIKE ? OR username LIKE ?)"
                search_pattern = f"%{search_text}%"
                params.extend([search_pattern, search_pattern, search_pattern, search_pattern])
        
        if category != "All" and self.current_role == 'admin' and not self.is_admin_viewing_teacher:
            query += " AND category = ?"
            params.append(category)
        
        if self.current_role == 'admin' and not self.is_admin_viewing_teacher:
            query += " ORDER BY c.last_name, c.first_name"
        else:
            query += " ORDER BY last_name, first_name"
        
        # Execute query
        self.cursor.execute(query, params)
        credentials = self.cursor.fetchall()
        
        # Add to treeview based on role
        if self.current_role == 'admin' and not self.is_admin_viewing_teacher:
            for cred in credentials:
                cred_id, lrn, id_number, first_name, last_name, grade_level, section, category, status, attachments_json, updated_at, teacher_name = cred
                
                # Parse attachments JSON
                try:
                    attachments = json.loads(attachments_json) if attachments_json else []
                except:
                    attachments = []
                
                # Display attachment count
                if attachments:
                    display_attachments = f"{len(attachments)} file(s)"
                else:
                    display_attachments = "No attachments"
                
                # Display teacher name
                teacher_display = teacher_name if teacher_name else "Admin"
                
                self.cred_tree.insert('', 'end', values=(cred_id, lrn if lrn else '', id_number if id_number else '', 
                                                         first_name, last_name, grade_level if grade_level else '', 
                                                         section if section else '', category, status if status else 'Active', 
                                                         teacher_display, display_attachments, updated_at))
        else:
            for cred in credentials:
                if self.is_admin_viewing_teacher or self.current_role == 'user':
                    cred_id, lrn, id_number, first_name, last_name, status, attachments_json, updated_at = cred
                else:
                    # For admin viewing without teacher mode (shouldn't happen here)
                    continue
                
                # Parse attachments JSON
                try:
                    attachments = json.loads(attachments_json) if attachments_json else []
                except:
                    attachments = []
                
                # Display attachment count
                if attachments:
                    display_attachments = f"{len(attachments)} file(s)"
                else:
                    display_attachments = "No attachments"
                
                self.cred_tree.insert('', 'end', values=(cred_id, lrn if lrn else '', id_number if id_number else '', 
                                                         first_name, last_name, status if status else 'Active', 
                                                         display_attachments, updated_at))
    
    def filter_credentials(self):
        """Filter student records based on search and category"""
        search_text = self.search_var.get()
        if self.current_role == 'admin' and not self.is_admin_viewing_teacher:
            category = self.category_var.get()
        else:
            category = "All"
        self.load_credentials(search_text, category)
    
