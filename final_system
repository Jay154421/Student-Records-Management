    def load_users_table(self):
        """Load users into the Treeview with optional search filter."""
        if not hasattr(self, "user_tree"):
            return

        search = ""
        if hasattr(self, "user_search_var"):
            search = self.user_search_var.get().strip()

        # Clear
        for item in self.user_tree.get_children():
            self.user_tree.delete(item)

        try:
            if search:
                like = f"%{search}%"
                self.cursor.execute("""
                    SELECT id, username, full_name, role, email, assigned_grade, assigned_section, created_at, last_login
                    FROM users
                    WHERE username LIKE ? OR full_name LIKE ? OR email LIKE ? OR role LIKE ? 
                    OR assigned_grade LIKE ? OR assigned_section LIKE ?
                    ORDER BY id DESC
                """, (like, like, like, like, like, like))
            else:
                self.cursor.execute("""
                    SELECT id, username, full_name, role, email, assigned_grade, assigned_section, created_at, last_login
                    FROM users
                    ORDER BY id DESC
                """)
            rows = self.cursor.fetchall()

            for r in rows:
                uid, username, full_name, role, email, assigned_grade, assigned_section, created_at, last_login = r
                created = (created_at[:10] if created_at else "")
                last = (last_login[:10] if last_login else "")
                self.user_tree.insert("", "end", values=(uid, username, full_name or "", role or "", email or "", 
                                                       assigned_grade or "", assigned_section or "", created, last))
        except Exception as e:
            messagebox.showerror("Error", f"Failed to load users:\n{e}")
    
    def on_user_select(self):
        """Fill form when a user is selected."""
        if not hasattr(self, "user_tree"):
            return
        sel = self.user_tree.selection()
        if not sel:
