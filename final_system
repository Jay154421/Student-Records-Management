    def _get_student_latest_grades(self, student_id):
        """Get latest saved grades for student across classes (most recent updated_at)."""
        self.cursor.execute('''
            SELECT prelim, midterm, semifinal, final
            FROM student_grades
            WHERE student_id = ?
            ORDER BY updated_at DESC
            LIMIT 1
        ''', (student_id,))
        row = self.cursor.fetchone()
        if not row:
            return ("", "", "", "")
        return tuple("" if v is None else v for v in row)

    def _calculate_student_total_gpa(self, student_id):
        """Average prelim/midterm/semifinal/final across latest record."""
        p, m, s, f = self._get_student_latest_grades(student_id)
        vals = []
        for v in (p, m, s, f):
            try:
                if v != "":
                    vals.append(float(v))
            except Exception:
                pass
        if not vals:
            return ""
        return round(sum(vals) / len(vals), 2)

