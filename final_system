        def _grade_field(label, default):
            tk.Label(form, text=label, font=('Arial', 10, 'bold'), fg=self.colors['primary'], bg=self.colors['background']).pack(anchor='w', pady=(10, 5))
            e = tk.Entry(form, font=('Arial', 11), bd=1)
